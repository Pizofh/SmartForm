# Local Compose example only. Copy to .env, then replace all placeholders.
# Generate independent values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit .env or reuse these example values in a live deployment.

DEBUG=True
SECRET_KEY=REPLACE_WITH_NEW_RANDOM_DJANGO_SECRET
ALLOWED_HOSTS=127.0.0.1,localhost
RECAPTCHA_PUBLIC_KEY=REPLACE_WITH_TEST_OR_VALID_PUBLIC_KEY
RECAPTCHA_PRIVATE_KEY=REPLACE_WITH_TEST_OR_VALID_PRIVATE_KEY
DISABLE_CAPTCHA=True

# Both passwords below must be identical. For database URLs, escape reserved
# URL characters in the password; a token_urlsafe() secret avoids that issue.
POSTGRES_DB=smartform_db
POSTGRES_USER=smartform_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql://smartform_user:REPLACE_WITH_RANDOM_DB_PASSWORD@db:5432/smartform_db

PORT=8000
